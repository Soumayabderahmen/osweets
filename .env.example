# Connexion PostgreSQL — copie ce fichier en `.env` et adapte les valeurs.
# `.env` n'est jamais versionné (il est dans .gitignore).

# --- Écriture détaillée -------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=osweets
DB_USERNAME=postgres
DB_PASSWORD=root

# --- ou, au choix, l'URL complète (elle a priorité si elle est présente) --
# DATABASE_URL=postgresql://postgres:root@localhost:5432/osweets

# Mets `require` si la base est distante et impose TLS (Neon, Railway, RDS…).
# DATABASE_SSL=require
