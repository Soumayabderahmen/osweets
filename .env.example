# Connexion PostgreSQL — copie ce fichier en `.env` et adapte les valeurs.
# `.env` n'est jamais versionné (il est dans .gitignore).

# --- Écriture détaillée -------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=osweets
DB_USERNAME=postgres
DB_PASSWORD=root

# --- ou, au choix, l'URL complète (elle a priorité si elle est présente) --
# DATABASE_URL=postgresql://postgres:root@localhost:5432/osweets

# Mets `require` si la base est distante et impose TLS (Neon, Railway, RDS…).
# DATABASE_SSL=require

# --- Adresse publique du site -------------------------------------------
# Utilisée pour les balises `canonical`, Open Graph et le sitemap. Sans
# valeur, le site s'annonce sur le domaine de préproduction Lovable. À
# renseigner le jour de la mise en ligne sur le domaine définitif, sinon
# Google continuerait d'indexer la préproduction.
# VITE_SITE_URL=https://osweets.fr
